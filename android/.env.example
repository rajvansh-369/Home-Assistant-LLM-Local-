# Android application id. Hard to change after the first install.
ANDROID_PACKAGE=com.yourname.aster
# "Maps SDK for Android" key for the map on 1.4 Set home (Phase 5).
GOOGLE_MAPS_API_KEY=
# The only host a release build may call over plain HTTP (zypherLL), e.g. 192.168.1.20.
HOME_LLM_HOST=
# Mock server layer: 1 until Phase 7, then 0.
EXPO_PUBLIC_USE_MOCK_API=1
# Optional. Prefills 1.2 Sign in in dev builds only, e.g. https://aster.yourdomain.com
EXPO_PUBLIC_DEV_SERVER_URL=
