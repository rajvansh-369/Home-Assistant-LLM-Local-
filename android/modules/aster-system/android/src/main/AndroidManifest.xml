<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "Run in background": the system dialog that sets battery use to Unrestricted. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!-- "Hey Aster" (docs/aster-voice-plan.md §6, §7): the microphone foreground service, and 3.6
       over the lock screen when the wake word is heard with the screen off. RECORD_AUDIO is asked
       at 1.5. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <!-- "Open" on the missed-message notification and 4.2 launch these apps (Android 11+ needs them
       listed). docs/aster-messages-alerts-plan.md §4. -->
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
    <package android:name="com.google.android.apps.dynamite" />
    <package android:name="com.google.android.apps.messaging" />
    <package android:name="com.samsung.android.messaging" />
    <package android:name="com.android.messaging" />
    <!-- 3.6 Voice (docs/aster-voice-plan.md §4): the speech recognizer and TextToSpeech engines. -->
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <application>
    <!-- Message capture (docs/aster-messages-alerts-plan.md §4); also lists Aster under
         Notification access. -->
    <service
      android:name="expo.modules.astersystem.AsterNotificationListener"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- The wake word's listening service. -->
    <service
      android:name="expo.modules.astersystem.WakeWordService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Missed and remind timers, and "Remind in 30 min" (§7). Only Aster sends to it. -->
    <receiver
      android:name="expo.modules.astersystem.AlertReceiver"
      android:exported="false" />
  </application>
</manifest>
