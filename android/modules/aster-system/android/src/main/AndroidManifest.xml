<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "Run in background": the system dialog that sets battery use to Unrestricted. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Lists Aster under Notification access. Does nothing yet; message capture is row 4. -->
    <service
      android:name="expo.modules.astersystem.AsterNotificationListener"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
