        },
        {
          "name": "Rate good",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/memory/{{memoryId}}/rate?engine={{engine}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "memory",
                "{{memoryId}}",
                "rate"
              ],
              "query": [
                {
                  "key": "engine",
                  "value": "{{engine}}"
                }
