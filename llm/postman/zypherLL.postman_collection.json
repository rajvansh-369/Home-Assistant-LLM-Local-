{
  "info": {
    "_postman_id": "bc8d61ff-5f61-43ac-82e8-9e79ba68fe99",
    "name": "zypherLL",
    "description": "zypherLL: local Zephyr 7B or Mark-L (Gemini), behind one OpenAI-compatible API.\n\n1. Start the server: `python main.py serve`\n2. Import `zypherLL.local.postman_environment.json` too and select it, or edit the collection variables.\n3. Set `apiKey` to the same value as `ZYPHER_API_KEY` in `.env` (leave empty if the server runs without one).\n4. Set `engine` to `local` (Zephyr on this PC) or `markl` (Mark-L on Gemini; needs `ZYPHER_MARKL_GEMINI_KEY` in `.env`). Every Chat and Memory request uses it; requests named \"(Mark-L)\" always use Mark-L.\n\nEvery request except Health sends `Authorization: Bearer {{apiKey}}` (collection-level auth).\n\nLocal chat requests save the stored exchange's id into `memoryId`, which the Rate requests use. Mark-L keeps named facts instead of exchanges, so it has no ratings: Rate answers 400 with `engine` = `markl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "memoryId",
      "value": ""
    },
    {
      "key": "engine",
      "value": "local",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "`status`, `error` and `model` are the default engine's (`loading` / `ready` / `error`); `engines` has both: local `loading` | `ready` | `error` | `off`, markl `ready` | `unconfigured`. No API key needed -- poll it while the model loads.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reports both engines', () => pm.expect(pm.response.json().engines).to.have.all.keys('local', 'markl'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "models"
              ]
            },
            "description": "Both engines in the OpenAI list shape: `zephyr-7b` (engine `local`) and `mark-l` (engine `markl`), each with its `status`. Either id works as `model` in a chat request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settings"
              ]
            },
            "description": "Server-wide defaults a request gets when it does not say, including the default `engine` and a `markl` block: status, Gemini model in use, mode (free / paid), quota cooldown, tools and name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settings"
              ]
            },
            "description": "Change server-wide defaults. Every field is optional. `engine` (`local` | `markl`) is what a request gets when it names none. `markl_mode`: `free` keeps Mark-L inside a free Gemini key's quota (lite model, DuckDuckGo, 8 req/min); `paid` uses the full model and Google-grounded search. `web: true` also re-arms lookups paused after network failures. `max_tokens` is the local answer budget.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"local\",\n  \"markl_mode\": \"free\",\n  \"web\": true,\n  \"memory\": true,\n  \"max_tokens\": 4096\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set default engine",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settings"
              ]
            },
            "description": "Make `{{engine}}` the server default, for clients that never name an engine.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('default is {{engine}}', () => pm.expect(pm.response.json().engine).to.eql(pm.variables.get('engine')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Plain question. The router decides whether to search the web; memory recalls similar past exchanges. Response `zypher` carries sources, recall count, captured notes and `memory_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How do I reverse a list in Python?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));",
                  "const meta = pm.response.json().zypher || {};",
                  "if (meta.memory_id) {",
                  "    pm.collectionVariables.set('memoryId', meta.memory_id);",
                  "    console.log('memoryId =', meta.memory_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Server-sent events in the OpenAI chunk format, ending with `data: [DONE]`. Status chunks (searching / recalled) carry a `zypher` field and an empty delta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"stream\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a haiku about local LLMs.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Chat (force web search)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "`web: true` always searches, even when the router would not or web lookup is off server-wide -- same as `/web <question>`. Answers cite sources as [n].",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"web\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is the latest stable Python release?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (multi-turn + system)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Send the whole conversation each time, as with OpenAI. A system message is appended to the runner's own system prompt, not swapped in for it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Answer in one short paragraph.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"What is a KV cache?\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"A KV cache stores the attention keys and values of tokens already processed, so they are not recomputed for each new token.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Why does it run out on small GPUs?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));",
                  "const meta = pm.response.json().zypher || {};",
                  "if (meta.memory_id) {",
                  "    pm.collectionVariables.set('memoryId', meta.memory_id);",
                  "    console.log('memoryId =', meta.memory_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (continue a cut-off answer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "End `messages` with the partial assistant reply to continue it in place, like `continue` in the console. The response content is only the new text -- append it to what you had.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a Python function that checks whether a string is a palindrome.\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"```python\\ndef is_palindrome(text):\\n\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (tuned: no memory, creative, budget)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Runner extensions: `memory: false` skips recall and learning for this call; `sampling` picks `precise` / `balanced` / `creative`; `temperature` / `top_p` override it (`temperature: 0` = greedy). `max_tokens` is capped at the server budget; `min_tokens` forbids ending the answer before that many tokens. `sampling` and the local answer budget apply to the local engine; Mark-L picks its own sampling.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"memory\": false,\n  \"web\": false,\n  \"sampling\": \"creative\",\n  \"temperature\": 0.9,\n  \"max_tokens\": 400,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Brainstorm five names for a local AI assistant.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (long, detailed: min_tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "`min_tokens` forbids the model from ending its turn until the answer is that many tokens long -- for when Zephyr stops too soon (`finish_reason: stop` on a short answer). Capped at `max_tokens` and the server budget (4096 on a 6 GB card). Set it higher than the model has things to say and it pads with repetition; 500-1000 suits a detailed explanation. Local engine only: Mark-L has no `min_tokens`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"{{engine}}\",\n  \"min_tokens\": 800,\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain Python decorators in detail, with examples.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by {{engine}}', () => pm.expect((pm.response.json().zypher || {}).engine).to.eql(pm.variables.get('engine')));",
                  "const body = pm.response.json();",
                  "console.log('completion_tokens =', body.usage.completion_tokens, 'finish_reason =', body.choices[0].finish_reason);"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (Mark-L)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Answered by the Mark-L engine (Gemini) instead of the local model. `engine` picks it (or `\"model\": \"mark-l\"`); `assistant_name` is what it calls itself. Tools it used are in `zypher.tools`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engine\": \"markl\",\n  \"assistant_name\": \"Mark-L\",\n  \"stream\": false,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How is my PC doing right now?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answered by Mark-L', () => pm.expect(pm.response.json().zypher.engine).to.eql('markl'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat (Mark-L, streaming, web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            },
            "description": "Mark-L streaming with a forced web search: a `{\"stage\": \"searching\"}` status chunk arrives before the text.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"mark-l\",\n  \"stream\": true,\n  \"web\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"One headline from today's tech news.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Memory",
